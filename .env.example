# LLM configuration (OpenAI-compatible API)
LLM_API_KEY=sk-or-v1-sua-chave
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b

# Caminho do banco de dados SQLite
DATABASE_URL=sqlite:///var/emporio.db

# Autenticação de requisições externas. Se não definida, não haverá autenticação.
API_KEY=

# Data de Hoje para regras dependentes de tempo (YYYY-MM-DD).
# Se vazio, será utilizada a data real no fuso horário especificado em STORE_TZ.
REFERENCE_DATE=
STORE_TZ=America/Campo_Grande
