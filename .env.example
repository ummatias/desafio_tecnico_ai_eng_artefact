# LLM configuration (OpenAI-compatible API)
LLM_API_KEY=sk-or-v1-sua-chave
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# 0 a 2. Padrão 0.2 (medido nos evals).
LLM_TEMPERATURE=0.2
# Providers do OpenRouter em ordem, sem fallback (ex.: deepinfra,groq). vazio = roteamento
# padrão, com fallback. baseten: o provider medido nos evals; fixá-lo deixa as rodadas
# comparáveis, mas sem ele disponível as chamadas falham (e o agente abre chamado).
LLM_PROVIDERS=baseten
# deny: só providers que não guardam os dados das conversas (padrão).
LLM_DATA_COLLECTION=deny
# low, medium ou high. vazio = padrão do modelo.
LLM_REASONING_EFFORT=

# Caminho do banco de dados SQLite
DATABASE_URL=sqlite:///var/emporio.db

# Pasta com os CSVs originais (somente leitura)
DATA_DIR=data

# Autenticação de requisições externas. Se não definida, não haverá autenticação.
API_KEY=

# "Agora" para regras dependentes de tempo: YYYY-MM-DD (vale às 10:00) ou YYYY-MM-DDTHH:MM,
# no fuso STORE_TZ. Se vazio, será utilizado o relógio real.
REFERENCE_DATE=
STORE_TZ=America/Campo_Grande

# Fonte da data de recebimento: none (padrão) ou fixture (eventos sintéticos de
# fixtures/delivery_events.csv, só para exemplos e evals).
TRACKING_SOURCE=none

# P-08: dias úteis até um pedido pending/confirmed ser considerado parado.
STALLED_AFTER_BUSINESS_DAYS=5

# Trace JSONL do agente: uma linha por turno, com dados pessoais mascarados.
TRACE_ENABLED=true
TRACE_PATH=var/traces/turns.jsonl

# Juiz de tom dos evals (id de modelo no OpenRouter, diferente de LLM_MODEL).
# Vazio: tom e recusa saem como n/d no relatório.
EVAL_JUDGE_MODEL=
